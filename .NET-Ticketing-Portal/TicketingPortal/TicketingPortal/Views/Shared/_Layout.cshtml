<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketingPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light m-0 p-0">

    <div class="d-flex flex-column vh-100 overflow-hidden">

        <!-- Top Navbar -->
        <header class="flex-shrink-0">
            <nav class="navbar navbar-expand-sm navbar-dark border-bottom" style="background-color: #0b0f19; border-color: #1e293b !important;">
                <div class="container-fluid px-4">
                    <a class="navbar-brand fw-bold text-white tracking-wide" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shield-check text-primary me-2"></i>Ticketing Portal
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                        </ul>

                        <ul class="navbar-nav align-items-center gap-2">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item text-end me-2">
                                    <div class="text-white small fw-medium">Welcome, @User.Identity.Name</div>
                                    <span class="badge bg-primary text-uppercase" style="font-size: 0.65rem;">
                                        @(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Employee")
                                    </span>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-outline-danger btn-sm px-3" asp-controller="Account" asp-action="Logout">Logout</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Login">Sign In</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Body Area: Horizontal Flexbox (Sidebar + Main Content) -->
        <div class="d-flex flex-grow-1 overflow-hidden">

            <!-- Left Sidebar -->
            <aside class="sidebar d-flex flex-column flex-shrink-0 p-3"
                   style="width: 260px; background-color: #0f172a; border-right: 1px solid #1e293b; overflow-y: auto;">

                <!-- Navigation Categories -->
                <div class="mb-4">
                    <div class="text-uppercase text-secondary fw-bold px-3 mb-2" style="font-size: 11px; letter-spacing: 0.08em;">
                        Main
                    </div>
                    <ul class="nav nav-pills flex-column gap-1">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index"
                               class="nav-link text-white d-flex align-items-center gap-2 px-3 py-2 rounded-2 active"
                               style="background-color: #2563eb;">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Ticket" asp-action="Index"
                               class="nav-link text-light text-opacity-75 d-flex align-items-center justify-content-between px-3 py-2 rounded-2 hover-sidebar">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-ticket-detailed"></i>
                                    <span>My Tickets</span>
                                </div>
                                <span class="badge bg-primary rounded-pill px-2" style="font-size: 10px;">3</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Ticket" asp-action="Create"
                               class="nav-link text-light text-opacity-75 d-flex align-items-center gap-2 px-3 py-2 rounded-2 hover-sidebar">
                                <i class="bi bi-plus-circle"></i>
                                <span>Raise Ticket</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="mb-4">
                    <div class="text-uppercase text-secondary fw-bold px-3 mb-2" style="font-size: 11px; letter-spacing: 0.08em;">
                        Workforce
                    </div>
                    <ul class="nav nav-pills flex-column gap-1">
                        <li class="nav-item">
                            <a asp-controller="Timesheet" asp-action="Index"
                               class="nav-link text-light text-opacity-75 d-flex align-items-center gap-2 px-3 py-2 rounded-2 hover-sidebar">
                                <i class="bi bi-clock-history"></i>
                                <span>Timesheet</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Leave" asp-action="Index"
                               class="nav-link text-light text-opacity-75 d-flex align-items-center gap-2 px-3 py-2 rounded-2 hover-sidebar">
                                <i class="bi bi-calendar-check"></i>
                                <span>My Leaves</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Attendance" asp-action="Index"
                               class="nav-link text-light text-opacity-75 d-flex align-items-center gap-2 px-3 py-2 rounded-2 hover-sidebar">
                                <i class="bi bi-person-check"></i>
                                <span>Attendance</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Bottom Profile Snippet -->
                <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 d-flex align-items-center gap-2 px-2">
                    <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center"
                         style="width: 36px; height: 36px; font-size: 14px;">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-white text-truncate fw-medium small">@(User.Identity?.Name ?? "User")</div>
                        <div class="text-secondary small" style="font-size: 11px;">Developer</div>
                    </div>
                </div>

            </aside>

            <!-- Main Page Viewport -->
            <main role="main" class="flex-grow-1 p-4 overflow-auto" style="background-color: #0b0f19;">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>